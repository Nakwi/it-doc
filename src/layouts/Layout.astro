---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import Header from '../components/Header.jsx';
import Sidebar from '../components/Sidebar.jsx';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  showSidebar?: boolean;
  image?: string;
  type?: 'website' | 'article';
  keywords?: string[];
  noindex?: boolean;
  structuredData?: object;
}

const {
  title,
  description = "Documentation technique pour BTS SIO et Bachelor informatique",
  currentPath = "",
  showSidebar = true,
  image,
  type = 'website',
  keywords = [],
  noindex = false,
  structuredData,
} = Astro.props;

// Canonical URL & OG image
const origin = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;
const canonicalURL = `${origin}${Astro.url.pathname}`;
const ogImage = image
  ? (image.startsWith('http') ? image : `${origin}${image}`)
  : null;

const pageTitle = `${title} | IT-DOC`;

// Default WebSite structured data
const defaultStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'IT-DOC',
  description: 'Documentation technique pour BTS SIO et Bachelor informatique',
  url: origin,
  inLanguage: 'fr-FR',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${origin}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const jsonLd = JSON.stringify(structuredData ?? defaultStructuredData);

// Get procedure counts for sidebar
const allProcedures = await getCollection('procedures');
const procedureCounts: Record<string, Record<string, number>> = {};

allProcedures.forEach(p => {
  if (!procedureCounts[p.data.category]) {
    procedureCounts[p.data.category] = {};
  }
  if (!procedureCounts[p.data.category][p.data.subcategory]) {
    procedureCounts[p.data.category][p.data.subcategory] = 0;
  }
  procedureCounts[p.data.category][p.data.subcategory]++;
});

import docsData from '../data/docs.json';

const sanitizeString = (str: string): string => {
  return str
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026')
    .replace(/'/g, '\\u0027')
    .replace(/"/g, '\\u0022');
};

const searchData = allProcedures.map(p => {
  const category = docsData.categories.find(c => c.id === p.data.category);
  const subcategory = category?.subcategories.find(s => s.id === p.data.subcategory);
  return {
    id: sanitizeString(p.slug),
    title: sanitizeString(p.data.title),
    tags: (p.data.tags || []).map(t => sanitizeString(t)),
    level: sanitizeString(p.data.level),
    duration: p.data.duration,
    categoryId: sanitizeString(p.data.category),
    categoryLabel: sanitizeString(category?.label || p.data.category),
    subcategoryId: sanitizeString(p.data.subcategory),
    subcategoryLabel: sanitizeString(subcategory?.label || p.data.subcategory),
    color: category?.color || '#0078D4'
  };
});
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="acTEYAusovLb5q_PJ9IiENNW5f4NJ3f0Nbj-1MWwZ7s" />

    <!-- Primary Meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="author" content="IT-DOC" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="IT-DOC" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="fr_FR" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={title} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Umami Analytics (cookie-free) -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="3105cb1e-17c5-4c89-a03f-d9b6382b6219"></script>

    <script is:inline>
      if (localStorage.getItem('theme') === 'dark' ||
          (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
    <script is:inline define:vars={{ searchData }}>
      window.__PROCEDURES__ = searchData;
    </script>
  </head>
  <body class="min-h-screen bg-[var(--color-bg-primary)]">
    <Header client:load />

    <div class="flex">
      {showSidebar && <Sidebar currentPath={currentPath} procedureCounts={procedureCounts} client:load />}

      <main class={`flex-1 min-h-[calc(100vh-64px)] ${showSidebar ? '' : ''}`}>
        <slot />
      </main>
    </div>
  </body>
</html>
