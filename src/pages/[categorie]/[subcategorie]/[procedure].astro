---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.jsx';
import LevelBadge from '../../../components/LevelBadge.jsx';
import docsData from '../../../data/docs.json';

export function getStaticPaths() {
  const paths = [];

  docsData.categories.forEach(category => {
    category.subcategories.forEach(subcategory => {
      subcategory.procedures.forEach(procedure => {
        paths.push({
          params: {
            categorie: category.id,
            subcategorie: subcategory.id,
            procedure: procedure.id
          },
          props: {
            category,
            subcategory,
            procedure
          }
        });
      });
    });
  });

  return paths;
}

const { categorie, subcategorie } = Astro.params;
const { category, subcategory, procedure } = Astro.props;

const breadcrumbItems = [
  { label: category.label, href: `/${category.id}` },
  { label: subcategory.label, href: `/${category.id}/${subcategory.id}` },
  { label: procedure.title }
];

// Simple markdown to HTML converter
function parseMarkdown(content: string): string {
  return content
    // Headers
    .replace(/^### (.*$)/gm, '<h3>$1</h3>')
    .replace(/^## (.*$)/gm, '<h2>$1</h2>')
    .replace(/^# (.*$)/gm, '<h1>$1</h1>')
    // Code blocks
    .replace(/```(\w+)?\n([\s\S]*?)```/g, '<pre><code>$2</code></pre>')
    // Inline code
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    // Bold
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    // Lists
    .replace(/^- (.*$)/gm, '<li>$1</li>')
    .replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>')
    // Numbered lists
    .replace(/^\d+\. (.*$)/gm, '<li>$1</li>')
    // Paragraphs
    .replace(/\n\n/g, '</p><p>')
    .replace(/^(?!<[huplo])/gm, '')
    ;
}
---

<Layout
  title={procedure.title}
  description={`${procedure.title} - ${category.label}`}
  currentPath={`/${categorie}/${subcategorie}/${procedure.id}`}
>
  <div class="p-6 lg:p-10">
    <div class="max-w-4xl mx-auto">
      <!-- Back Button -->
      <a
        href={`/${category.id}/${subcategory.id}`}
        class="inline-flex items-center gap-2 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors mb-6"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Retour
      </a>

      <Breadcrumb items={breadcrumbItems} />

      <!-- Hero Image -->
      <div class="aspect-video bg-[var(--color-bg-tertiary)] rounded-xl mb-8 overflow-hidden relative">
        {procedure.cover ? (
          <img
            src={procedure.cover}
            alt={procedure.title}
            class="w-full h-full object-cover"
          />
        ) : null}
        <div class="absolute inset-0 flex items-center justify-center">
          <svg
            class="w-20 h-20 text-[var(--color-text-secondary)] opacity-20"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
      </div>

      <!-- Procedure Header -->
      <div class="mb-8">
        <h1 class="font-display text-3xl font-bold text-[var(--color-text-primary)] mb-4">
          {procedure.title}
        </h1>

        <div class="flex flex-wrap items-center gap-4">
          <LevelBadge level={procedure.level} />

          <span class="flex items-center gap-1.5 text-sm text-[var(--color-text-secondary)]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {procedure.duration} minutes
          </span>

          {procedure.tags && procedure.tags.map(tag => (
            <span class="px-3 py-1 text-sm bg-[var(--color-bg-tertiary)] text-[var(--color-text-secondary)] rounded-full">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <!-- Procedure Content -->
      <article class="prose-content">
        <Fragment set:html={parseMarkdown(procedure.content)} />
      </article>

      <!-- Navigation -->
      <div class="mt-12 pt-8 border-t border-[var(--color-border)]">
        <div class="flex justify-between items-center">
          <a
            href={`/${category.id}/${subcategory.id}`}
            class="inline-flex items-center gap-2 px-4 py-2 bg-[var(--color-bg-secondary)] rounded-lg text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Retour aux procédures
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
