---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.jsx';
import docsData from '../../../data/docs.json';

// Get all procedures from Content Collections
const allProcedures = await getCollection('procedures');

export async function getStaticPaths() {
  const paths = [];
  const allProcs = await getCollection('procedures');

  docsData.categories.forEach(category => {
    category.subcategories.forEach(subcategory => {
      // Get procedures for this subcategory from Content Collections
      const procs = allProcs.filter(p =>
        p.data.category === category.id &&
        p.data.subcategory === subcategory.id
      );

      paths.push({
        params: {
          categorie: category.id,
          subcategorie: subcategory.id
        },
        props: {
          category,
          subcategory,
          procedures: procs
        }
      });
    });
  });

  return paths;
}

const { categorie, subcategorie } = Astro.params;
const { category, subcategory, procedures } = Astro.props;

const breadcrumbItems = [
  { label: category.label, href: `/${category.id}` },
  { label: subcategory.label }
];

// Helper function for level badge classes
function getLevelBadgeClasses(level: string) {
  switch (level) {
    case 'Débutant':
      return 'bg-[#DCFCE7] text-[#16A34A]';
    case 'Intermédiaire':
      return 'bg-[#FEF3C7] text-[#D97706]';
    case 'Avancé':
      return 'bg-[#FEE2E2] text-[#DC2626]';
    default:
      return 'bg-gray-100 text-gray-600';
  }
}
---

<Layout
  title={`${subcategory.label} - ${category.label}`}
  description={`${procedures.length} procédure${procedures.length > 1 ? 's' : ''} ${subcategory.label} pour ${category.label} — Documentation IT-DOC pour BTS SIO et Bachelor informatique.`}
  currentPath={`/${categorie}/${subcategorie}`}
  keywords={[subcategory.label, category.label, 'BTS SIO', 'Bachelor informatique', 'documentation technique']}
>
  <div class="p-6 lg:p-10">
    <div class="max-w-5xl mx-auto">
      <Breadcrumb items={breadcrumbItems} />

      <!-- Subcategory Header -->
      <div class="mb-8">
        <h1 class="font-display text-3xl font-bold text-[var(--color-text-primary)] mb-2">
          {subcategory.label}
        </h1>
        <p class="text-[var(--color-text-secondary)]">
          {procedures.length} procédure{procedures.length > 1 ? 's' : ''} disponible{procedures.length > 1 ? 's' : ''}
        </p>
      </div>

      <!-- Procedures Grid -->
      {procedures.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {procedures.map(procedure => (
            <a
              href={`/procedure/${procedure.slug}`}
              class="group block bg-[var(--color-bg-primary)] rounded-xl border border-[var(--color-border)] overflow-hidden card-hover"
            >
              <!-- Cover Image -->
              <div class="aspect-video bg-[var(--color-bg-tertiary)] relative overflow-hidden">
                {procedure.data.cover ? (
                  <img
                    src={procedure.data.cover}
                    alt={procedure.data.title}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center">
                    <svg
                      class="w-12 h-12 text-[var(--color-text-secondary)] opacity-30"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                  </div>
                )}
              </div>

              <!-- Content -->
              <div class="p-4">
                <h3 class="font-semibold text-[var(--color-text-primary)] line-clamp-2 group-hover:underline">
                  {procedure.data.title}
                </h3>

                <div class="flex items-center gap-3 mt-3">
                  <span class={`inline-flex px-2.5 py-1 text-xs font-medium rounded-full ${getLevelBadgeClasses(procedure.data.level)}`}>
                    {procedure.data.level}
                  </span>
                  <span class="flex items-center gap-1 text-sm text-[var(--color-text-secondary)]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {procedure.data.duration} min
                  </span>
                </div>

                {procedure.data.tags && procedure.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1 mt-3">
                    {procedure.data.tags.slice(0, 2).map(tag => (
                      <span class="px-2 py-0.5 text-xs bg-[var(--color-bg-tertiary)] text-[var(--color-text-secondary)] rounded">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-[var(--color-bg-secondary)] rounded-xl">
          <svg class="w-16 h-16 mx-auto text-[var(--color-text-secondary)] opacity-50 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <p class="text-[var(--color-text-secondary)]">Aucune procédure disponible pour le moment</p>
        </div>
      )}
    </div>
  </div>
</Layout>
