---
import Layout from '../layouts/Layout.astro';

const team = [
  {
    name: 'Ryan Corsyn',
    role: 'Master Infra Réseau Cloud',
    avatar: 'RC',
    color: '#0078D4'
  },
  {
    name: 'Norman Skovgaard',
    role: 'Master Infra Réseau Cloud',
    avatar: 'NS',
    color: '#E95420'
  },
  {
    name: 'Matteo Panariello',
    role: 'Master Infra Réseau Cloud',
    avatar: 'MP',
    color: '#00B4D8'
  },
  {
    name: 'Angelo Vazquez',
    role: 'Master Infra Réseau Cloud',
    avatar: 'AV',
    color: '#7B2FBE'
  }
];
---

<Layout title="À propos" currentPath="/a-propos">
  <div class="p-6 lg:p-10 max-w-4xl mx-auto">

    <!-- Hero Section -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-gradient-to-br from-[#0078D4] to-[#00B4D8] mb-6">
        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <h1 class="font-display text-4xl lg:text-5xl font-bold text-[var(--color-text-primary)] mb-4">
        À propos d'IT-DOC
      </h1>
      <p class="text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto">
        Des documentations techniques créées par des étudiants, pour des étudiants.
      </p>
    </div>

    <!-- Mission Section -->
    <div class="bg-[var(--color-bg-secondary)] rounded-2xl p-8 mb-12 border border-[var(--color-border)]">
      <h2 class="font-display text-2xl font-semibold text-[var(--color-text-primary)] mb-4 flex items-center gap-3">
        <span class="w-10 h-10 rounded-xl bg-[#0078D4]/10 flex items-center justify-center">
          <svg class="w-5 h-5 text-[#0078D4]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </span>
        Notre mission
      </h2>
      <p class="text-[var(--color-text-secondary)] leading-relaxed mb-4">
        IT-DOC est né d'un constat simple : les documentations techniques sont souvent complexes,
        dispersées et peu adaptées aux étudiants qui débutent dans l'administration systèmes et réseaux.
      </p>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">
        Notre objectif est de proposer des <strong class="text-[var(--color-text-primary)]">procédures claires,
        structurées et illustrées</strong> pour accompagner les étudiants en <strong class="text-[var(--color-text-primary)]">BTS SIO</strong>
        et <strong class="text-[var(--color-text-primary)]">Bachelor</strong> dans leur apprentissage des technologies
        d'infrastructure, de virtualisation et de sécurité.
      </p>
    </div>

    <!-- Features Grid -->
    <div class="grid md:grid-cols-3 gap-6 mb-16">
      <div class="bg-[var(--color-bg-primary)] rounded-xl p-6 border border-[var(--color-border)]">
        <div class="w-12 h-12 rounded-xl bg-[#E95420]/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-[#E95420]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="font-display font-semibold text-[var(--color-text-primary)] mb-2">Testé et validé</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">
          Chaque procédure est testée en environnement réel avant publication.
        </p>
      </div>

      <div class="bg-[var(--color-bg-primary)] rounded-xl p-6 border border-[var(--color-border)]">
        <div class="w-12 h-12 rounded-xl bg-[#00B4D8]/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-[#00B4D8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="font-display font-semibold text-[var(--color-text-primary)] mb-2">Illustré</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">
          Des captures d'écran à chaque étape pour ne jamais être perdu.
        </p>
      </div>

      <div class="bg-[var(--color-bg-primary)] rounded-xl p-6 border border-[var(--color-border)]">
        <div class="w-12 h-12 rounded-xl bg-[#7B2FBE]/10 flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-[#7B2FBE]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
        </div>
        <h3 class="font-display font-semibold text-[var(--color-text-primary)] mb-2">Adapté</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">
          3 niveaux de difficulté pour progresser à son rythme.
        </p>
      </div>
    </div>

    <!-- Team Section -->
    <div class="mb-16">
      <h2 class="font-display text-2xl font-semibold text-[var(--color-text-primary)] mb-2 text-center">
        L'équipe
      </h2>
      <p class="text-[var(--color-text-secondary)] text-center mb-8">
        Étudiants en Master Infrastructure Réseau & Cloud
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {team.map((member) => (
          <div class="bg-[var(--color-bg-primary)] rounded-xl p-6 border border-[var(--color-border)] text-center card-hover">
            <div
              class="w-16 h-16 rounded-full mx-auto mb-4 flex items-center justify-center text-white font-display font-bold text-lg"
              style={`background: linear-gradient(135deg, ${member.color}, ${member.color}dd)`}
            >
              {member.avatar}
            </div>
            <h3 class="font-display font-semibold text-[var(--color-text-primary)] mb-1">
              {member.name}
            </h3>
            <p class="text-sm text-[var(--color-text-secondary)]">
              {member.role}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Contact Section -->
    <div class="bg-gradient-to-br from-[#0078D4]/10 to-[#00B4D8]/10 rounded-2xl p-8 border border-[#0078D4]/20 text-center">
      <h2 class="font-display text-2xl font-semibold text-[var(--color-text-primary)] mb-3">
        Une suggestion ?
      </h2>
      <p class="text-[var(--color-text-secondary)] mb-6">
        Vous avez repéré une erreur ou souhaitez proposer une nouvelle procédure ?<br/>
        N'hésitez pas à contribuer sur GitHub.
      </p>
      <a
        href="https://github.com/Nakwi/it-doc"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--color-text-primary)] text-[var(--color-bg-primary)] rounded-xl font-medium hover:opacity-90 transition-opacity"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        Voir sur GitHub
      </a>
    </div>

  </div>
</Layout>
