---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.jsx';
import LevelBadge from '../../components/LevelBadge.jsx';
import ReadingProgress from '../../components/ReadingProgress.jsx';
import docsData from '../../data/docs.json';

export async function getStaticPaths() {
  const procedures = await getCollection('procedures');
  return procedures.map(procedure => ({
    params: { slug: procedure.slug },
    props: { procedure },
  }));
}

const { procedure } = Astro.props;
const { Content, headings } = await procedure.render();

const category = docsData.categories.find(c => c.id === procedure.data.category);
const subcategory = category?.subcategories.find(s => s.id === procedure.data.subcategory);

const breadcrumbItems = [
  { label: category?.label || procedure.data.category, href: `/${procedure.data.category}` },
  { label: subcategory?.label || procedure.data.subcategory, href: `/${procedure.data.category}/${procedure.data.subcategory}` },
  { label: procedure.data.title }
];

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

// SEO
const seoDescription = [
  `Procédure ${procedure.data.level.toLowerCase()}`,
  category?.label,
  subcategory?.label,
  `— ${procedure.data.title}.`,
  `Durée estimée : ${procedure.data.duration} minutes.`,
  'Documentation IT pour BTS SIO et Bachelor.',
].filter(Boolean).join(' ');

const proficiencyMap: Record<string, string> = {
  'Débutant': 'Beginner',
  'Intermédiaire': 'Intermediate',
  'Avancé': 'Expert',
};

const origin = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;

const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: procedure.data.title,
  description: seoDescription,
  url: `${origin}/procedure/${procedure.slug}`,
  inLanguage: 'fr-FR',
  proficiencyLevel: proficiencyMap[procedure.data.level] ?? procedure.data.level,
  ...(procedure.data.tags?.length ? { keywords: procedure.data.tags.join(', ') } : {}),
  ...(procedure.data.cover ? { image: procedure.data.cover.startsWith('http') ? procedure.data.cover : `${origin}${procedure.data.cover}` } : {}),
  author: {
    '@type': 'Organization',
    name: 'IT-DOC',
    url: origin,
  },
  publisher: {
    '@type': 'Organization',
    name: 'IT-DOC',
    url: origin,
  },
  isPartOf: {
    '@type': 'WebSite',
    name: 'IT-DOC',
    url: origin,
  },
};
---

<Layout
  title={procedure.data.title}
  description={seoDescription}
  currentPath={`/${procedure.data.category}/${procedure.data.subcategory}`}
  type="article"
  image={procedure.data.cover}
  keywords={procedure.data.tags}
  structuredData={articleStructuredData}
>
  <ReadingProgress client:load />
  <div class="p-6 lg:p-10">
    <div class="max-w-7xl mx-auto">
      <div class="flex gap-10">
        <!-- Main Content -->
        <div class="flex-1 max-w-4xl">
          <!-- Back Button -->
          <a
            href={`/${procedure.data.category}/${procedure.data.subcategory}`}
            class="inline-flex items-center gap-2 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors mb-6"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Retour
          </a>

          <Breadcrumb items={breadcrumbItems} />

          <!-- Procedure Header -->
          <div class="mb-8">
            <h1 class="font-display text-3xl font-bold text-[var(--color-text-primary)] mb-4">
              {procedure.data.title}
            </h1>

            <div class="flex flex-wrap items-center gap-4">
              <LevelBadge level={procedure.data.level} />

              <span class="flex items-center gap-1.5 text-sm text-[var(--color-text-secondary)]">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {procedure.data.duration} minutes
              </span>

              {procedure.data.tags && procedure.data.tags.map(tag => (
                <a
                  href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
                  class="px-3 py-1 text-sm bg-[var(--color-bg-tertiary)] text-[var(--color-text-secondary)] rounded-full hover:bg-[#0078D4]/10 hover:text-[#0078D4] transition-colors"
                >
                  {tag}
                </a>
              ))}
            </div>
          </div>

          <!-- Procedure Content -->
          <article class="prose-content">
            <Content />
          </article>

          <!-- Navigation -->
          <div class="mt-12 pt-8 border-t border-[var(--color-border)]">
            <a
              href={`/${procedure.data.category}/${procedure.data.subcategory}`}
              class="inline-flex items-center gap-2 px-4 py-2 bg-[var(--color-bg-secondary)] rounded-lg text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              Retour aux procédures
            </a>
          </div>
        </div>

        <!-- Table of Contents Sidebar -->
        {tocHeadings.length > 0 && (
          <aside class="hidden xl:block w-64 shrink-0">
            <div class="sticky top-24">
              <div class="bg-[var(--color-bg-secondary)] rounded-xl p-5 border border-[var(--color-border)]">
                <h4 class="font-display font-semibold text-sm text-[var(--color-text-primary)] mb-4 flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#0078D4]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                  </svg>
                  Sommaire
                </h4>
                <nav class="toc-nav">
                  <ul class="space-y-1">
                    {tocHeadings.map((heading) => (
                      <li>
                        <a
                          href={`#${heading.slug}`}
                          class={`toc-link block py-1.5 text-sm transition-colors ${
                            heading.depth === 3 ? 'pl-4 text-xs' : ''
                          }`}
                          data-heading={heading.slug}
                        >
                          {heading.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            </div>
          </aside>
        )}
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* TOC styles */
  .toc-link {
    color: var(--color-text-secondary);
    border-left: 2px solid transparent;
    padding-left: 0.75rem;
  }

  .toc-link:hover {
    color: var(--color-text-primary);
  }

  .toc-link.active {
    color: #0078D4;
    border-left-color: #0078D4;
    font-weight: 500;
  }

  .prose-content img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
  }

  .prose-content a {
    color: #0078D4;
    text-decoration: underline;
  }

  .prose-content a:hover {
    text-decoration: none;
  }

  .prose-content blockquote {
    border-left: 4px solid var(--color-border);
    padding-left: 1rem;
    margin: 1rem 0;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .prose-content hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }

  /* Code block wrapper */
  .code-block-wrapper {
    position: relative;
    margin: 1.5rem 0;
    border-radius: 12px;
    overflow: hidden;
    background: #1a1b26;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  /* Code block header */
  .code-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    background: #24283b;
    border-bottom: 1px solid #414868;
  }

  .code-block-lang {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: #7aa2f7;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .code-block-lang::before {
    content: '';
    width: 8px;
    height: 8px;
    background: #7aa2f7;
    border-radius: 50%;
  }

  .code-block-dots {
    display: flex;
    gap: 6px;
  }

  .code-block-dots span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .code-block-dots span:nth-child(1) { background: #ff5f56; }
  .code-block-dots span:nth-child(2) { background: #ffbd2e; }
  .code-block-dots span:nth-child(3) { background: #27c93f; }

  /* Code block content */
  .prose-content pre {
    margin: 0 !important;
    padding: 1rem !important;
    background: #1a1b26 !important;
    border-radius: 0 !important;
    overflow-x: auto;
  }

  .prose-content pre code {
    background: transparent !important;
    padding: 0;
    font-size: 0.85rem;
    line-height: 1.7;
    color: #a9b1d6;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }

  /* Copy button */
  .copy-btn {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.6rem;
    background: transparent;
    border: 1px solid #414868;
    border-radius: 6px;
    color: #787c99;
    font-size: 0.7rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .copy-btn:hover {
    background: #414868;
    color: #c0caf5;
    border-color: #565f89;
  }

  .copy-btn.copied {
    background: #9ece6a;
    border-color: #9ece6a;
    color: #1a1b26;
  }

  .copy-btn svg {
    width: 12px;
    height: 12px;
  }
</style>

<script>
  setTimeout(() => {
    // Secure external links (add noopener noreferrer)
    document.querySelectorAll('.prose-content a[href^="http"]').forEach((link) => {
      const anchor = link as HTMLAnchorElement;
      if (!anchor.hostname.includes(window.location.hostname)) {
        anchor.setAttribute('rel', 'noopener noreferrer nofollow');
        anchor.setAttribute('target', '_blank');
      }
    });

    // Code blocks setup
    document.querySelectorAll('.prose-content pre').forEach((pre) => {
      if (pre.parentElement.classList.contains('code-block-wrapper')) return;

      const codeEl = pre.querySelector('code');
      const langMatch = codeEl?.className.match(/language-(\w+)/);
      const lang = langMatch ? langMatch[1] : 'code';

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';

      const header = document.createElement('div');
      header.className = 'code-block-header';

      const dots = document.createElement('div');
      dots.className = 'code-block-dots';
      dots.innerHTML = '<span></span><span></span><span></span>';

      const langSpan = document.createElement('span');
      langSpan.className = 'code-block-lang';
      langSpan.textContent = lang;

      const copyBtn = document.createElement('button');
      copyBtn.className = 'copy-btn';
      copyBtn.type = 'button';
      copyBtn.innerHTML = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg> Copier';

      copyBtn.addEventListener('click', function(e) {
        e.preventDefault();
        const textToCopy = codeEl ? codeEl.innerText : pre.innerText;

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(textToCopy).then(() => {
            copyBtn.innerHTML = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Copié !';
            copyBtn.classList.add('copied');
            setTimeout(() => {
              copyBtn.innerHTML = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg> Copier';
              copyBtn.classList.remove('copied');
            }, 2000);
          });
        } else {
          const textarea = document.createElement('textarea');
          textarea.value = textToCopy;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
          copyBtn.innerHTML = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Copié !';
          copyBtn.classList.add('copied');
          setTimeout(() => {
            copyBtn.innerHTML = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg> Copier';
            copyBtn.classList.remove('copied');
          }, 2000);
        }
      });

      header.appendChild(dots);
      header.appendChild(langSpan);
      header.appendChild(copyBtn);

      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(pre);
    });

    // TOC active state on scroll
    const tocLinks = document.querySelectorAll('.toc-link');
    const headings = document.querySelectorAll('.prose-content h2, .prose-content h3');

    if (tocLinks.length > 0 && headings.length > 0) {
      const observerOptions = {
        rootMargin: '-80px 0px -80% 0px',
        threshold: 0
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            tocLinks.forEach(link => link.classList.remove('active'));
            const activeLink = document.querySelector(`.toc-link[data-heading="${entry.target.id}"]`);
            if (activeLink) activeLink.classList.add('active');
          }
        });
      }, observerOptions);

      headings.forEach(heading => observer.observe(heading));
    }
  }, 100);
</script>
