---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LevelBadge from '../../components/LevelBadge.jsx';
import docsData from '../../data/docs.json';

export async function getStaticPaths() {
  const procedures = await getCollection('procedures');

  // Get all unique tags
  const allTags = new Set<string>();
  procedures.forEach(p => {
    p.data.tags?.forEach(tag => allTags.add(tag));
  });

  return Array.from(allTags).map(tag => ({
    params: { tag: tag.toLowerCase().replace(/\s+/g, '-') },
    props: {
      tag,
      procedures: procedures.filter(p => p.data.tags?.includes(tag))
    },
  }));
}

const { tag, procedures } = Astro.props;

const getCategoryInfo = (categoryId: string) => {
  return docsData.categories.find(c => c.id === categoryId);
};

const categoryEmojis: Record<string, string> = {
  'windows-server': '🪟',
  'linux': '🐧',
  'reseau': '🌐',
  'securite': '🔒',
  'virtualisation': '💻'
};
---

<Layout title={`Tag: ${tag}`} currentPath="/tags">
  <div class="p-6 lg:p-10">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <a
          href="/tags"
          class="inline-flex items-center gap-2 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors mb-4"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Tous les tags
        </a>

        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-[#0078D4]/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-[#0078D4]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
          </div>
          <div>
            <h1 class="font-display text-2xl font-bold text-[var(--color-text-primary)]">
              {tag}
            </h1>
            <p class="text-[var(--color-text-secondary)]">
              {procedures.length} procédure{procedures.length > 1 ? 's' : ''}
            </p>
          </div>
        </div>
      </div>

      <!-- Procedures Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {procedures.map((procedure) => {
          const category = getCategoryInfo(procedure.data.category);
          return (
            <a
              href={`/procedure/${procedure.slug}`}
              class="group block bg-[var(--color-bg-primary)] rounded-xl border border-[var(--color-border)] overflow-hidden card-hover"
            >
              <!-- Cover Image -->
              <div class="aspect-video bg-[var(--color-bg-tertiary)] overflow-hidden">
                {procedure.data.cover ? (
                  <img
                    src={procedure.data.cover}
                    alt={procedure.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-4xl">
                    {categoryEmojis[procedure.data.category] || '📄'}
                  </div>
                )}
              </div>

              <!-- Content -->
              <div class="p-4">
                <div class="flex items-center gap-2 mb-2">
                  <span
                    class="w-2 h-2 rounded-full"
                    style={`background-color: ${category?.color || '#666'}`}
                  ></span>
                  <span class="text-xs text-[var(--color-text-secondary)]">
                    {category?.label}
                  </span>
                </div>
                <h3 class="font-display font-semibold text-sm text-[var(--color-text-primary)] group-hover:text-[#0078D4] transition-colors line-clamp-2 mb-3">
                  {procedure.data.title}
                </h3>
                <div class="flex items-center justify-between">
                  <LevelBadge level={procedure.data.level} />
                  <span class="flex items-center gap-1 text-xs text-[var(--color-text-secondary)]">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {procedure.data.duration} min
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</Layout>
